# Build output. The site is generated; what is served lives on the dist branch,
# which the GitHub Action writes. Nothing generated belongs on main.
/dist/
/_site/
/_plain/
/.publish/
/.dist-check/
/dist-check/
# Any other name somebody points --out at. The build writes wherever it
# is told, and a generated tree that lands in a commit is worse than a
# tidy ignore list. `_plain` above is the one this list was missing when
# it was written, and it is the name .github/workflows/build.yml itself
# passes to --out - so it is the name most likely to be sitting in a
# working tree when somebody types `git add -A`. It was, and 3,816
# generated files went in.
dist-*/
__pycache__/

# Nothing here has a dependency to install, and package.json declares no
# packages - but `npm install` is a reflex, and its output does not belong here.
node_modules/
package-lock.json

# OS metadata
Thumbs.db
desktop.ini
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# Scratch images used when testing the URL importer
__test-*.png

# Cloudflare API tokens and anything else local
.env
*.token

# Written by scripts/emit_media.py as the input to rendering media/*.png.
media/src/
