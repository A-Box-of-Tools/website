# Build output. The site is generated; what is served lives on the dist branch,
# which the GitHub Action writes. Nothing generated belongs on main.
/dist/
/_site/
/.publish/
/.dist-check/
__pycache__/

# OS metadata
Thumbs.db
desktop.ini
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# Scratch images used when testing the URL importer
__test-*.png

# Cloudflare API tokens and anything else local
.env
*.token
