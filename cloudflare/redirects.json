{
  "description": "A 301 for every address a tool used to answer at. Generated by cloudflare/redirects.py from [redirects] in config/site.toml - change that, not this. See cloudflare/README.md.",
  "rules": [
    {
      "ref": "moved_en_json_formatter",
      "description": "en: /text-tools, /format-json -> /json-formatter/",
      "expression": "http.request.uri.path in {\"/text-tools\" \"/text-tools/\" \"/format-json\" \"/format-json/\"}",
      "action": "redirect",
      "enabled": true,
      "action_parameters": {
        "from_value": {
          "status_code": 301,
          "target_url": {
            "value": "https://abox.tools/json-formatter/"
          },
          "preserve_query_string": true
        }
      }
    },
    {
      "ref": "moved_en_text_diff",
      "description": "en: /compare-text -> /text-diff/",
      "expression": "http.request.uri.path in {\"/compare-text\" \"/compare-text/\"}",
      "action": "redirect",
      "enabled": true,
      "action_parameters": {
        "from_value": {
          "status_code": 301,
          "target_url": {
            "value": "https://abox.tools/text-diff/"
          },
          "preserve_query_string": true
        }
      }
    },
    {
      "ref": "moved_en_base64",
      "description": "en: /encode-text -> /base64/",
      "expression": "http.request.uri.path in {\"/encode-text\" \"/encode-text/\"}",
      "action": "redirect",
      "enabled": true,
      "action_parameters": {
        "from_value": {
          "status_code": 301,
          "target_url": {
            "value": "https://abox.tools/base64/"
          },
          "preserve_query_string": true
        }
      }
    },
    {
      "ref": "moved_en_pdf_to_csv",
      "description": "en: /bank-statement-to-csv -> /pdf-to-csv/",
      "expression": "http.request.uri.path in {\"/bank-statement-to-csv\" \"/bank-statement-to-csv/\"}",
      "action": "redirect",
      "enabled": true,
      "action_parameters": {
        "from_value": {
          "status_code": 301,
          "target_url": {
            "value": "https://abox.tools/pdf-to-csv/"
          },
          "preserve_query_string": true
        }
      }
    },
    {
      "ref": "moved_zh_json_formatter",
      "description": "zh: /zh/text-tools, /zh/format-json -> /zh/json-formatter/",
      "expression": "http.request.uri.path in {\"/zh/text-tools\" \"/zh/text-tools/\" \"/zh/format-json\" \"/zh/format-json/\"}",
      "action": "redirect",
      "enabled": true,
      "action_parameters": {
        "from_value": {
          "status_code": 301,
          "target_url": {
            "value": "https://abox.tools/zh/json-formatter/"
          },
          "preserve_query_string": true
        }
      }
    },
    {
      "ref": "moved_zh_text_diff",
      "description": "zh: /zh/compare-text -> /zh/text-diff/",
      "expression": "http.request.uri.path in {\"/zh/compare-text\" \"/zh/compare-text/\"}",
      "action": "redirect",
      "enabled": true,
      "action_parameters": {
        "from_value": {
          "status_code": 301,
          "target_url": {
            "value": "https://abox.tools/zh/text-diff/"
          },
          "preserve_query_string": true
        }
      }
    },
    {
      "ref": "moved_zh_base64",
      "description": "zh: /zh/encode-text -> /zh/base64/",
      "expression": "http.request.uri.path in {\"/zh/encode-text\" \"/zh/encode-text/\"}",
      "action": "redirect",
      "enabled": true,
      "action_parameters": {
        "from_value": {
          "status_code": 301,
          "target_url": {
            "value": "https://abox.tools/zh/base64/"
          },
          "preserve_query_string": true
        }
      }
    },
    {
      "ref": "moved_zh_pdf_to_csv",
      "description": "zh: /zh/bank-statement-to-csv -> /zh/pdf-to-csv/",
      "expression": "http.request.uri.path in {\"/zh/bank-statement-to-csv\" \"/zh/bank-statement-to-csv/\"}",
      "action": "redirect",
      "enabled": true,
      "action_parameters": {
        "from_value": {
          "status_code": 301,
          "target_url": {
            "value": "https://abox.tools/zh/pdf-to-csv/"
          },
          "preserve_query_string": true
        }
      }
    }
  ]
}
