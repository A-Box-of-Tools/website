  "name": "\u091f\u0947\u0915\u094d\u0938\u094d\u091f \u0914\u0930 \u092b\u093c\u093e\u0907\u0932\u0947\u0902 \u0938\u093e\u091d\u093e \u0915\u0930\u0947\u0902",
  "short_name": "\u091f\u0947\u0915\u094d\u0938\u094d\u091f \u0914\u0930 \u092b\u093c\u093e\u0907\u0932\u0947\u0902 \u0938\u093e\u091d\u093e \u0915\u0930\u0947\u0902",
  "description": "\u0938\u093e\u091d\u093e \u0915\u0940 \u0917\u0908 \u091a\u0940\u091c\u093c \u0907\u0938\u0940 \u0916\u0941\u0932\u0947 \u091f\u0948\u092c \u092e\u0947\u0902 \u0930\u0939\u0924\u0940 \u0939\u0948\u0964 \u092a\u093e\u0920\u0915 \u0909\u0938\u0947 \u090f\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f\u0947\u0921 \u0930\u0942\u092a \u092e\u0947\u0902 \u0938\u0940\u0927\u0947 \u0906\u092a\u0915\u0947 \u092c\u094d\u0930\u093e\u0909\u091c\u093c\u0930 \u0938\u0947 \u092a\u093e\u0924\u0947 \u0939\u0948\u0902, \u0914\u0930 \u091f\u0948\u092c \u092c\u0902\u0926 \u0915\u0930\u0924\u0947 \u0939\u0940 \u0938\u092c \u0916\u0924\u094d\u092e - \u0915\u093f\u0938\u0940 \u0938\u0930\u094d\u0935\u0930 \u092a\u0930 \u0915\u0941\u091b \u0928\u0939\u0940\u0902 \u0930\u0939\u0924\u093e\u0964",
